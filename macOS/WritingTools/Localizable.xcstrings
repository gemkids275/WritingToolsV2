    "You can always adjust these later in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können diese jederzeit später in den Einstellungen anpassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
