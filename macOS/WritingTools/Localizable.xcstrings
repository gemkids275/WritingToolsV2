    "When enabled, the selected text is treated as content to process, not as instructions" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option aktiviert ist, wird der ausgewählte Text als zu verarbeitender Inhalt behandelt und nicht als Anweisung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está habilitado, el texto seleccionado se trata como contenido para procesar, no como instrucciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, le texte sélectionné est traité comme du contenu à traiter, et non comme des instructions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、選択したテキストは指示としてではなく、処理するコンテンツとして扱われます"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, văn bản đã chọn được coi là nội dung cần xử lý, không phải hướng dẫn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，所选文本将被视为要处理的内容，而非指令"
          }
        }
      }
    },
    "When off, custom prompts replace selected text inline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, ersetzen benutzerdefinierte Eingabeaufforderungen den ausgewählten Text inline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está desactivado, los indicadores personalizados reemplazan el texto seleccionado en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque désactivé, les invites personnalisées remplacent le texte sélectionné en ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合、カスタムプロンプトは選択したテキストをインラインで置換します。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tắt, lệnh tùy chỉnh thay thế văn bản đã chọn trực tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，自定义提示词将直接替换所选文本。"
          }
        }
      }
    },
    "When unchecked, custom prompts will replace selected text inline" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn nicht aktiviert, ersetzen benutzerdefinierte Eingabeaufforderungen ausgewählte Text-Inline"
