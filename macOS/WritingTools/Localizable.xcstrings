    },
    "You can rerun the onboarding flow to review permissions and quickly configure the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können den Onboarding-Fluss erneut ausführen, um Berechtigungen zu überprüfen und die App schnell zu konfigurieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes volver a ejecutar el flujo de incorporación para revisar los permisos y configurar rápidamente la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez réexécuter le flux d'intégration pour vérifier les autorisations et configurer rapidement l'application."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンボーディングを再実行して、権限の確認とアプリの設定ができます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể chạy lại hướng dẫn để xem lại các quyền và cấu hình ứng dụng nhanh chóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以重新运行引导流程，以检查权限并快速配置应用。"
          }
        }
      }
    },
    "You can revisit onboarding anytime from Settings > General > Onboarding." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können das Onboarding jederzeit unter \"Einstellungen\" > \"Allgemein\" > \"Onboarding\" erneut besuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes revisar la incorporación en cualquier momento desde Configuración > General > Incorporación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez revoir l'intégration à tout moment à partir de Paramètres > Général > Intégration."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
