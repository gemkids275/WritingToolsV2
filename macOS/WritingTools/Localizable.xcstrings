          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque non coché, les invites personnalisées remplaceront le texte sélectionné en ligne"
          }
        },
        "ja" : {
          "stringUnit" : {
